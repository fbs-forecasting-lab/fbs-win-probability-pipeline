# College Football Data API
CFBD_API_KEY=

# The Odds API
ODDS_API_KEY=

# National Weather Service requests should identify the application
NWS_USER_AGENT=

# Optional S3 demo configuration: select an existing private project bucket.
# These values are nonsecret. Do not put AWS credentials in this file.
# Authentication uses the standard AWS SDK profile/SSO/temporary-credential chain.
FBS_S3_BUCKET=
FBS_S3_REGION=
FBS_S3_PREFIX=
# Optional named profile; blank uses the SDK's normal profile selection.
FBS_AWS_PROFILE=
